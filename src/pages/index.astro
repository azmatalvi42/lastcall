                    <div class="agent-photo"><Picture src={estateSale} formats={['avif', 'webp']} widths={[400, 720]} sizes="320px" alt="" loading="lazy" /></div>
                    <div class="agent-panel">
                      <p class="agent-head"><i></i>Creating listing</p>
                      <p class="agent-row agent-row-strong"><span>Mantel clock</span><b>$65.00</b></p>
                      <p class="agent-check">Photographed</p>
                      <p class="agent-check">Listed</p>
                    </div>
                    <span class="agent-hint"></span>
                  </div>
                  <div class="agent-face agent-back" aria-hidden="true">
                    <p class="agent-kicker">Listing</p>
                    <h3>Every piece gets its own listing.</h3>
                    <p>An agent turns your photos and price cards into organized listings, so nothing in the house gets missed.</p>
                    <span class="agent-hint"></span>
                  </div>
                </div>
              </div>
              <div class="agent-item">
                <button type="button" class="agent-flip" aria-pressed="false" aria-label="Uploading: show more"></button>
                <div class="agent-flipper">
                  <div class="agent-face agent-front" aria-hidden="true">
                    <div class="agent-photo"><Picture src={estateAuction} formats={['avif', 'webp']} widths={[400, 720]} sizes="320px" alt="" loading="lazy" /></div>
                    <div class="agent-panel">
                      <p class="agent-head"><i></i>Uploading photos</p>
