      <!-- HOW IT WORKS -->
      <section id="how" class="quiz-scene" aria-label="How it works" data-mood="0">
        <div class="trusted trusted--quiz">
          <p class="eyebrow">Trusted by</p>
          <div class="logo-marquee">
            <div class="logo-track">
              {[false, true].map((copy) => partners.map(({ name, logo, width, height }) => logo ? (
                <img class="logo-mark" src={logo} alt={copy ? '' : name} aria-hidden={copy ? 'true' : undefined} width={width} height={height} style={`height:${logoHeights[name]}`} loading="eager" decoding="async" />
              ) : (
