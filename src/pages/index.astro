---
import { Picture } from 'astro:assets';
import '../styles/global.css';
import { site, telHref, tooLargeMessage, servicePromises, commissionSentence } from '../config/site';
import estateAuction from '../assets/img/estate-auction.jpg';
import onlineSale from '../assets/img/online-sale.jpg';
import estateSale from '../assets/img/estate-sale.jpg';
import garageSale from '../assets/img/garage-sale.jpg';
import buyoutHouse from '../assets/img/buyout-house.jpg';
import antiquesTable from '../assets/img/antiques-table.jpg';
import AuctionSketch from '../components/sketches/AuctionSketch.astro';
import EstateSaleSketch from '../components/sketches/EstateSaleSketch.astro';
import BuyoutSketch from '../components/sketches/BuyoutSketch.astro';
import OnlineSaleSketch from '../components/sketches/OnlineSaleSketch.astro';
import GarageSaleSketch from '../components/sketches/GarageSaleSketch.astro';
import PanelIcon from '../components/sketches/PanelIcon.astro';

const P = servicePromises;
const regionList = site.regions.join(', ').replace(/, ([^,]*)$/, ' and $1');
const title = `${site.businessName} | Estate sales, auctions and full house buyouts across the GTA`;
const description = `Need to sell a house full of things in ${regionList}? We run estate sales, estate auctions, garage sales and online sales, or we buy the whole house. Free walkthrough.`;
const year = new Date().getFullYear();
const cta = 'Get my free offer';

const agentLine = 'Our AI agents list, upload, describe and optimize your gems, then find the buyers and make the ads.';

const faqs = [
  {
    q: 'How does the buyout offer work?',
    a: `After a free walkthrough, we give you one written offer for the contents of the home. There is no obligation. If you accept, we agree a date, pack everything up and empty the house quickly${P.broomClean ? ', leaving it broom-clean' : ''}.`,
  },
  {
    q: 'How quickly can you empty the house?',
    a: 'It depends on the size of the home and how full it is. A buyout is usually the quickest option. An estate sale runs for 2 to 3 days, with setup beforehand and clean-out after. We will give you dates at the walkthrough.',
  },
  {
    q: 'How much does it cost?',
    a: `The walkthrough and the offer are free. With a buyout, we pay you one agreed amount for the contents, set out in writing. With an estate sale, you keep the proceeds, less our commission. ${commissionSentence}`,
  },
  {
    q: 'How do I know whether a buyout or a sale is right?',
    a: 'A buyout is simpler and quicker, which helps when the house is sold or listed, or when you would rather not host a sale. A sale can make sense when there is time and the home has plenty of furniture, collectibles or household goods. We will tell you honestly which one we think fits, and why.',
  },
  {
    q: 'Can family keep some things first?',
    a: `Yes. Take whatever you want before we start.${P.keepsakesFirst ? ' If we come across photos, letters or personal papers while sorting, we set them aside for you instead of selling them.' : ''}`,
  },
  {
    q: 'Do I need to be there?',
    a: 'Only for the walkthrough, and even that can be done with a family member or your realtor if you live out of town. After that, we keep you updated by phone or email.',
  },
  {
    q: 'What happens to things nobody keeps?',
    a: `${P.donateUsable ? 'We donate usable items to local charities, recycle what we can' : 'We recycle what we can'} and dispose of the rest properly. The plan for leftovers is written into your agreement.`,
  },
  {
    q: 'Do you work with executors and realtors?',
    a: `Yes. We can work to a listing or closing date and coordinate access with you.${P.executorSummary ? ' At the end, we send a written summary for the estate file.' : ''}`,
  },
  {
    q: 'Is the walkthrough really free?',
    a: 'Yes. The walkthrough and the written offer cost nothing, and there is no obligation. If you decide not to go ahead, that is completely fine.',
  },
];

/** Nine questions and the free space fill a five by two sheet. The free space sits under the A. Numbers are decoration. */
const bingoNumbers = ['4', '22', '37', '51', '68', '11', '19', '58', '73'];
const bingoSquares: ({ q: string; a: string; number: string } | null)[] = faqs.map((f, i) => ({ ...f, number: bingoNumbers[i] }));
bingoSquares.splice(7, 0, null);

/** Logos come from each company's own website. Height evens out how large they look, since their shapes differ. */
const partners: { name: string; logo?: string; width?: number; height?: number }[] = [
  { name: 'Dymon', logo: '/logos/dymon.png', width: 435, height: 169 },
  { name: 'Apple Self Storage', logo: '/logos/apple-self-storage.png', width: 300, height: 65 },
  { name: 'StorageVault', logo: '/logos/storagevault.png', width: 900, height: 156 },
  { name: 'Sentinel', logo: '/logos/sentinel.svg', width: 200, height: 60 },
  { name: 'Public Storage', logo: '/logos/public-storage.png', width: 186, height: 98 },
  { name: 'Access Storage', logo: '/logos/access-storage.svg', width: 550, height: 250 },
  { name: 'Mink Storage' },
  { name: 'U-Haul', logo: '/logos/u-haul.svg', width: 100, height: 16 },
];
const logoHeights: Record<string, string> = {
  Dymon: '2.25rem',
  'Apple Self Storage': '1.75rem',
  StorageVault: '1.5rem',
  Sentinel: '2.25rem',
  'Public Storage': '2.5rem',
  'Access Storage': '2.5rem',
  'U-Haul': '1.25rem',
};
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#120c08" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="pb-24 md:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 btn btn-primary">Skip to main content</a>

    <main id="main">
      <!-- HERO -->
      <section class="hero relative isolate flex items-center justify-center overflow-hidden h-[100svh]">
        <div class="hero-montage absolute inset-0 z-0" aria-hidden="true">
          <img class="hero-still absolute inset-0 h-full w-full object-cover" src="/hero-doorway-poster.jpg" alt="" width="1280" height="720" fetchpriority="high" decoding="async" />
          <video class="hero-video is-under absolute inset-0 h-full w-full object-cover" poster="/hero-doorway-poster.jpg" src="/hero-doorway.mp4" autoplay muted playsinline preload="auto" disablepictureinpicture tabindex="-1"></video>
          <video class="hero-video absolute inset-0 h-full w-full object-cover" muted playsinline preload="none" disablepictureinpicture tabindex="-1"></video>
        </div>
        <img class="hero-logo" src="/logos/last-call-logo-light.png" alt="Last Call" width="900" height="227" fetchpriority="high" decoding="async" />
        <div class="hero-copy relative z-10 mx-auto w-full max-w-5xl px-5 py-28 text-center">
          <h1>Loved once.<br><em>Loved forever.</em></h1>
          <p class="hero-lede">You've made the memories. Now let someone else make theirs.</p>
          <a class="hero-cta" href="#how-we-work">Let Last Call handle it</a>
        </div>
      </section>
      <script>
        // Each clip keeps its subject in view when a narrow screen crops the sides.
        const clips = ['/hero-doorway.mp4', '/hero-family.mp4', '/hero-kitchen.mp4', '/hero-bedroom.mp4'];
        const focus = ['68% center', '24% center', '56% center', '50% center'];
        const fadeMs = 900;
        const players: HTMLVideoElement[] = [];
        document.querySelectorAll('.hero-montage video').forEach((node) => {
          if (node instanceof HTMLVideoElement) players.push(node);
        });

        const whenReady = (video: HTMLVideoElement) => {
          if (video.readyState >= 2) return Promise.resolve();
          return new Promise<void>((resolve, reject) => {
            const ok = () => { cleanup(); resolve(); };
            const bad = () => { cleanup(); reject(new Error('clip')); };
            const cleanup = () => {
              video.removeEventListener('loadeddata', ok);
              video.removeEventListener('error', bad);
            };
            video.addEventListener('loadeddata', ok);
            video.addEventListener('error', bad);
            if (video.readyState >= 2) ok();
          });
        };

        const assign = async (video: HTMLVideoElement, index: number) => {
          const src = clips[index % clips.length];
          video.style.objectPosition = focus[index % clips.length];
          video.muted = true;
          video.playsInline = true;
          if (!video.currentSrc.endsWith(src)) {
            video.src = src;
            video.load();
          }
          await whenReady(video);
          video.currentTime = 0;
        };

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          players.forEach((video) => {
            video.removeAttribute('autoplay');
            video.pause();
          });
        } else if (players.length === 2) {
          let clip = 0;
          let active = 0;
          let switching = false;

          const advance = async () => {
            if (switching) return;
            switching = true;
            const previous = players[active];
            const next = players[1 - active];
            for (let attempt = 0; attempt < clips.length; attempt += 1) {
              clip = (clip + 1) % clips.length;
              try {
                await assign(next, clip);
                await next.play();
                next.classList.add('is-incoming');
                next.offsetWidth;
                next.classList.add('is-over');
                await new Promise((resolve) => window.setTimeout(resolve, fadeMs));
                previous.pause();
                previous.classList.remove('is-under');
                next.classList.remove('is-incoming', 'is-over');
                next.classList.add('is-under');
                active = 1 - active;
                assign(players[1 - active], clip + 1).catch(() => {});
                switching = false;
                return;
              } catch {
                /* This clip failed. Try the next one. */
              }
            }
            switching = false;
          };

          players.forEach((video) => {
            video.addEventListener('timeupdate', () => {
              if (video !== players[active] || switching) return;
              if (!(video.duration > 1) || video.currentTime < 0.4) return;
              const remaining = video.duration - video.currentTime;
              if (remaining <= fadeMs / 1000 + 0.05) advance();
            });
            video.addEventListener('ended', () => {
              if (video === players[active]) advance();
            });
          });

          const startFirst = () => {
            if (players[0].paused) players[0].play().catch(() => {});
          };
          players[0].classList.add('is-under');
          startFirst();
          players[0].addEventListener('canplay', startFirst, { once: true });
          assign(players[1], 1).catch(() => {});
        }

      </script>

      <!-- SALE FINDER -->
      <section id="find-a-sale" class="panel-scene" aria-label="The different services we offer">
        <p class="panel-title">The different services we offer</p>
        <div class="panel-acc" data-panel-acc>
          <svg class="sk-defs" aria-hidden="true" focusable="false">
            <defs>
              <filter id="sk-boil-a" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="2" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="3.5" xChannelSelector="R" yChannelSelector="G" /></filter>
              <filter id="sk-boil-b" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="7" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="3.5" xChannelSelector="R" yChannelSelector="G" /></filter>
              <filter id="sk-boil-c" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="13" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="3.5" xChannelSelector="R" yChannelSelector="G" /></filter>
              <pattern id="sk-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="7" stroke="#16120e" stroke-width="1.6" /></pattern>
            </defs>
          </svg>
          <article class="panel panel--drawn is-open">
            <div class="panel-sketch"><AuctionSketch /></div>
            <button type="button" class="panel-hit" aria-expanded="true">
              <span class="panel-index">01</span>
              <PanelIcon name="auction" />
              <span class="panel-vert">Estate Auctions</span>
              <span class="panel-plus" aria-hidden="true"></span>
            </button>
            <div class="panel-open-copy">
              <span class="panel-rule" aria-hidden="true"></span>
              <h2>Estate<br>Auctions</h2>
              <p class="panel-kicker">Rare finds. Real value.</p>
              <p class="panel-blurb">Photographed lots, bidding online, and pickup arranged for you.</p>
              <a class="panel-cta" href="#walkthrough">Ask about an estate auction</a>
            </div>
          </article>
          <article class="panel panel--drawn">
            <div class="panel-sketch"><OnlineSaleSketch /></div>
            <button type="button" class="panel-hit" aria-expanded="false">
              <span class="panel-index">02</span>
              <PanelIcon name="online" />
              <span class="panel-vert">Online Sales</span>
              <span class="panel-plus" aria-hidden="true"></span>
            </button>
            <div class="panel-open-copy">
              <span class="panel-rule" aria-hidden="true"></span>
              <h2>Online<br>Sales</h2>
              <p class="panel-kicker">Listed online. Found by buyers.</p>
              <p class="panel-blurb">We photograph, describe and list your things at set prices, then find the buyers.</p>
              <a class="panel-cta" href="#walkthrough">Ask about an online sale</a>
            </div>
          </article>
          <article class="panel panel--drawn">
            <div class="panel-sketch"><EstateSaleSketch /></div>
            <button type="button" class="panel-hit" aria-expanded="false">
              <span class="panel-index">03</span>
              <PanelIcon name="estate" />
              <span class="panel-vert">Estate Sales</span>
              <span class="panel-plus" aria-hidden="true"></span>
            </button>
            <div class="panel-open-copy">
              <span class="panel-rule" aria-hidden="true"></span>
              <h2>Estate<br>Sales</h2>
              <p class="panel-kicker">See it in the home.</p>
              <p class="panel-blurb">We price, stage, and run a sale in the house over a few days.</p>
              <a class="panel-cta" href="#walkthrough">Ask about an estate sale</a>
            </div>
          </article>
          <article class="panel panel--drawn">
            <div class="panel-sketch"><GarageSaleSketch /></div>
            <button type="button" class="panel-hit" aria-expanded="false">
              <span class="panel-index">04</span>
              <PanelIcon name="garage" />
              <span class="panel-vert">Garage Sales</span>
              <span class="panel-plus" aria-hidden="true"></span>
            </button>
            <div class="panel-open-copy">
              <span class="panel-rule" aria-hidden="true"></span>
              <h2>Garage<br>Sales</h2>
              <p class="panel-kicker">A Saturday, on the driveway.</p>
              <p class="panel-blurb">A neighbourhood sale we set up, run for the day, and tidy after.</p>
              <a class="panel-cta" href="#walkthrough">Ask about a garage sale</a>
            </div>
          </article>
          <article class="panel panel--drawn">
            <div class="panel-sketch"><BuyoutSketch /></div>
            <button type="button" class="panel-hit" aria-expanded="false">
              <span class="panel-index">05</span>
              <PanelIcon name="buyout" />
              <span class="panel-vert">Buyout Offers</span>
              <span class="panel-plus" aria-hidden="true"></span>
            </button>
            <div class="panel-open-copy">
              <span class="panel-rule" aria-hidden="true"></span>
              <h2>Buyout<br>Offers</h2>
              <p class="panel-kicker">One offer. The house cleared.</p>
              <p class="panel-blurb">One written offer for everything. Once you accept, we empty the house.</p>
              <a class="panel-cta" href="#walkthrough">Get a buyout offer</a>
            </div>
          </article>
        </div>
      </section>
      <script>
        const acc = document.querySelector('[data-panel-acc]');
        if (acc instanceof HTMLElement) {
          acc.addEventListener('click', (event) => {
            const hit = event.target instanceof Element ? event.target.closest('.panel-hit') : null;
            const panel = hit?.closest('.panel');
            if (!(panel instanceof HTMLElement) || panel.classList.contains('is-open')) return;
            acc.querySelectorAll('.panel').forEach((node) => {
              node.classList.remove('is-open');
              node.querySelector('.panel-hit')?.setAttribute('aria-expanded', 'false');
            });
            panel.classList.add('is-open');
            hit?.setAttribute('aria-expanded', 'true');
          });
        }
      </script>

      <!-- AI AGENTS -->
      <section id="agents" class="agents" aria-label="How our AI agents help" data-agents>
        <div class="agents-track">
          <div class="agents-stage">
            <svg class="agents-belt" aria-hidden="true"><rect fill="none" /><path fill="none" /></svg>
            <div class="agents-field">
              <div class="agent-item">
                <button type="button" class="agent-flip" aria-pressed="false" aria-label="Listing: show more"></button>
                <div class="agent-flipper">
