              )))}
            </div>
          </div>
        </div>

        <div class="maze-panel" data-maze aria-hidden="true">
          <div class="maze-photos">
            <Picture src={buyoutHouse} formats={['avif', 'webp']} widths={[800, 1400]} sizes="(max-width: 900px) 100vw, 60vw" alt="" loading="lazy" class="maze-photo" data-result-photo="buyout" />
            <Picture src={estateSale} formats={['avif', 'webp']} widths={[800, 1400]} sizes="(max-width: 900px) 100vw, 60vw" alt="" loading="lazy" class="maze-photo" data-result-photo="estate-sale" />
            <Picture src={estateAuction} formats={['avif', 'webp']} widths={[800, 1400]} sizes="(max-width: 900px) 100vw, 60vw" alt="" loading="lazy" class="maze-photo" data-result-photo="estate-auction" />
            <Picture src={garageSale} formats={['avif', 'webp']} widths={[800, 1400]} sizes="(max-width: 900px) 100vw, 60vw" alt="" loading="lazy" class="maze-photo" data-result-photo="garage-sale" />
            <Picture src={onlineSale} formats={['avif', 'webp']} widths={[800, 1400]} sizes="(max-width: 900px) 100vw, 60vw" alt="" loading="lazy" class="maze-photo" data-result-photo="online-sale" />
          </div>
        </div>
        <div class="quiz" data-quiz>
          <div class="quiz-top">
            <button type="button" class="quiz-back" data-quiz-back hidden>
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14"><path d="M8.8 2.6 4.4 7l4.4 4.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Back
            </button>
          </div>
          <div class="quiz-stage">
            <fieldset class="quiz-step is-on" data-step="0" tabindex="-1">
              <legend>What brings you to LastCall?</legend>
              <p class="quiz-lede">Answer four questions about your house. We will suggest the kind of sale that fits.</p>
              <button type="button" data-pick="downsizing">We are downsizing and cannot take everything</button>
              <button type="button" data-pick="moving">We are moving and the house needs to be emptied</button>
              <button type="button" data-pick="estate">We are settling a family estate</button>
              <button type="button" data-pick="listed">The house is sold or listed, and the contents have to go</button>
            </fieldset>
            <fieldset class="quiz-step" data-step="1" tabindex="-1">
              <legend>When does the house need to be ready?</legend>
              <button type="button" data-pick="asap">Before a closing or move date, as soon as we can</button>
              <button type="button" data-pick="weeks">Within the next few weeks</button>
              <button type="button" data-pick="months">We have a month or two</button>
              <button type="button" data-pick="flex">We are planning ahead. The date can flex</button>
            </fieldset>
            <fieldset class="quiz-step" data-step="2" tabindex="-1">
              <legend>What are you hoping to sell?</legend>
              <button type="button" data-pick="everyday">Everyday furniture and household belongings</button>
              <button type="button" data-pick="collectibles">Good furniture, art, or collectibles</button>
              <button type="button" data-pick="garage">Things in the garage, shed, or basement</button>
              <button type="button" data-pick="whole">A full house, with a bit of everything</button>
            </fieldset>
            <fieldset class="quiz-step" data-step="3" tabindex="-1">
              <legend>How would you like this to feel?</legend>
              <button type="button" data-pick="private">Quiet. We would rather not have strangers through the house</button>
              <button type="button" data-pick="neighbours">A simple neighbourhood sale is fine</button>
              <button type="button" data-pick="home">We are comfortable with a sale in the home</button>
              <button type="button" data-pick="online">We would rather sell it all online</button>
            </fieldset>
            <div class="quiz-step quiz-hold" data-step="hold" tabindex="-1">
              <p class="quiz-hold-line">Looking at your house</p>
            </div>
            <div class="quiz-step quiz-result" data-step="result" tabindex="-1">
              <div class="quiz-mark" data-result-mark aria-hidden="true"></div>
              <p class="eyebrow" data-result-kicker></p>
              <h3 data-result-title></h3>
              <p data-result-copy></p>
              <div class="quiz-actions">
                <a class="btn btn-primary" href="#walkthrough">Get started</a>
                <button type="button" data-quiz-reset>Start over</button>
              </div>
            </div>
          </div>
          <p class="quiz-note" data-quiz-note></p>
          <p class="sr-only" data-quiz-live aria-live="polite"></p>
        </div>
      </section>
      <script>
        import { mountMaze } from '../scripts/maze';

        const quiz = document.querySelector('[data-quiz]');
        if (quiz instanceof HTMLElement) {
          const steps = Array.from(quiz.querySelectorAll<HTMLElement>('.quiz-step'));
          const note = quiz.querySelector('[data-quiz-note]');
          const back = quiz.querySelector<HTMLButtonElement>('[data-quiz-back]');
          const live = quiz.querySelector('[data-quiz-live]');
          const world = document.querySelector<HTMLElement>('[data-maze]');
          const maze = world ? mountMaze(world) : null;
          const photos = Array.from(document.querySelectorAll<HTMLElement>('[data-result-photo]'));
          const answers: string[] = [];
          const results: Record<string, { kicker: string; title: string; copy: string }> = {
            buyout: {
              kicker: 'A buyout offer',
              title: 'One offer. The house cleared.',
              copy: 'You want this handled without a crowd in the home. We walk through, put one offer in writing, and empty the house once you accept.',
            },
            'estate-sale': {
              kicker: 'An estate sale',
              title: 'A sale in the home.',
              copy: 'There is enough in the house, and enough time, for people to come through. We price, stage, and run the sale, then clear what is left.',
            },
            'estate-auction': {
              kicker: 'An estate auction',
              title: 'Let the bidding find the price.',
              copy: 'Furniture and collectibles do well when buyers compete. We photograph the lots, run the auction, and arrange pickup.',
            },
            'garage-sale': {
              kicker: 'A garage sale',
              title: 'A Saturday, on the driveway.',
              copy: 'This is a neighbourhood sale, not a whole-house production. We set it up, run the day, and tidy after.',
            },
            'online-sale': {
              kicker: 'An online sale',
              title: 'Listed online. Found by buyers.',
              copy: 'Nobody has to come through the house to browse. We photograph, describe and list your things at set prices, then find the buyers.',
            },
          };

          const scene = quiz.closest<HTMLElement>('.quiz-scene');
          const marks: Record<string, string> = {
            buyout: '<path d="M4 12 12 5l8 7v7H4z"/>',
            'estate-sale': '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
            'estate-auction': '<path d="m14 13-8.381 8.38a1 1 0 0 1-3-3l8.384-8.381"/><path d="m16 16 6-6"/><path d="m21.5 10.5-8-8"/><path d="m8 8 6-6"/><path d="m8.5 7.5 8 8"/>',
            'garage-sale': '<path d="M18 21V10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v11"/><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 1.132-1.803l7.95-3.974a2 2 0 0 1 1.837 0l7.948 3.974A2 2 0 0 1 22 8z"/><path d="M6 13h12"/><path d="M6 17h12"/>',
            'online-sale': '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
          };
          const notes = ['Four short questions to the door.', 'Three more to the door.', 'Two more to the door.', 'Last one.', 'You made it to the door.'];
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const settleMs = reduceMotion ? 0 : 760;
          let place = 0;
          let busy = false;

          const show = (index: number | 'result' | 'hold', moveFocus = true) => {
            place = index === 'hold' ? 4 : index === 'result' ? 5 : index;
            const square = Math.min(place, 4);
            steps.forEach((step) => {
              const on = step.dataset.step === String(index);
              if (!on && step.classList.contains('is-on') && !reduceMotion) {
                step.classList.add('is-leaving');
                window.setTimeout(() => step.classList.remove('is-leaving'), 420);
              }
              if (on) step.classList.remove('is-leaving');
              step.classList.toggle('is-on', on);
            });
            if (note) note.textContent = notes[square];
            if (back) back.hidden = place < 1 || place > 3;
            if (scene) scene.dataset.mood = index === 'hold' || index === 'result' ? String(index) : String(place);
            maze?.goTo(square);
            if (!moveFocus) return;
            if (live) live.textContent = place < 4 ? `Question ${place + 1} of 4` : index === 'hold' ? 'Looking at your house' : `We suggest ${quiz.querySelector('[data-result-kicker]')?.textContent?.toLowerCase()}`;
            steps.find((step) => step.classList.contains('is-on'))?.focus({ preventScroll: true });
          };

          const recommend = () => {
            const score: Record<string, number> = { buyout: 0, 'estate-sale': 0, 'estate-auction': 0, 'garage-sale': 0, 'online-sale': 0 };
            const bump = (key: string, n: number) => { score[key] += n; };
            const [why, when, what, who] = answers;
            if (why === 'downsizing') bump('estate-sale', 2);
            if (why === 'moving') { bump('buyout', 2); bump('garage-sale', 1); }
            if (why === 'estate') { bump('estate-sale', 2); bump('estate-auction', 2); }
            if (why === 'listed') bump('buyout', 3);
            if (when === 'asap') { bump('buyout', 3); bump('online-sale', 1); }
            if (when === 'weeks') { bump('garage-sale', 2); bump('online-sale', 1); bump('estate-auction', 1); }
            if (when === 'months') { bump('estate-sale', 2); bump('estate-auction', 2); }
            if (when === 'flex') bump('estate-sale', 2);
            if (what === 'everyday') { bump('garage-sale', 2); bump('buyout', 1); }
            if (what === 'collectibles') { bump('estate-auction', 3); bump('estate-sale', 1); }
            if (what === 'garage') { bump('garage-sale', 3); bump('online-sale', 2); }
            if (what === 'whole') { bump('estate-sale', 2); bump('buyout', 2); }
            if (who === 'private') bump('buyout', 3);
            if (who === 'neighbours') bump('garage-sale', 3);
            if (who === 'home') bump('estate-sale', 3);
            if (who === 'online') { bump('estate-auction', 3); bump('online-sale', 5); }
            return Object.entries(score).sort((a, b) => b[1] - a[1])[0][0];
          };

          const setResult = (key: string) => {
            const result = results[key];
            const kicker = quiz.querySelector('[data-result-kicker]');
            const title = quiz.querySelector('[data-result-title]');
            const copy = quiz.querySelector('[data-result-copy]');
            const mark = quiz.querySelector('[data-result-mark]');
            if (kicker) kicker.textContent = result.kicker;
            if (title) title.textContent = result.title;
            if (copy) copy.textContent = result.copy;
            if (mark) mark.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${marks[key] || ''}</svg>`;
            // Shown now so the photo has loaded by the time you step through the door.
            photos.forEach((photo) => photo.classList.toggle('is-on', photo.dataset.resultPhoto === key));
          };

          quiz.addEventListener('click', (event) => {
            if (!(event.target instanceof Element)) return;
            const pick = event.target.closest<HTMLButtonElement>('[data-pick]');
            if (pick) {
              if (busy) return;
              busy = true;
              const step = pick.closest<HTMLElement>('[data-step]');
              const index = Number(step?.dataset.step || 0);
              answers[index] = pick.dataset.pick || '';
              step?.querySelectorAll('[data-pick]').forEach((option) => option.classList.toggle('is-chosen', option === pick));
              window.setTimeout(() => {
                if (index < 3) {
                  show(index + 1);
                  window.setTimeout(() => { busy = false; }, settleMs);
                  return;
                }
                setResult(recommend());
                show('hold');
                window.setTimeout(() => {
                  show('result');
                  busy = false;
                }, reduceMotion ? 250 : 2500);
              }, reduceMotion ? 0 : 300);
              return;
            }
            if (event.target.closest('[data-quiz-back]')) {
              if (!busy && place > 0) show(place - 1);
              return;
            }
            if (event.target.closest('[data-quiz-reset]')) {
              answers.length = 0;
              quiz.querySelectorAll('.is-chosen').forEach((option) => option.classList.remove('is-chosen'));
              show(0);
              maze?.goTo(0, true);
            }
          });
          show(0, false);
        }
      </script>

      <!-- FORM -->
      <section id="walkthrough" class="quiz-scene capture" data-mood="0">
        <div class="maze-panel" data-sale-scenes aria-hidden="true"></div>
        <div class="quiz">
          <div id="form-error" class="state capture-alert" tabindex="-1" role="alert">
            <p>Sorry, we could not send that. Please check your details and try again, or call <a href={telHref}>{site.phoneDisplay}</a>.</p>
          </div>
          <div id="too-large" class="state capture-alert" tabindex="-1" role="alert">
            <p>{tooLargeMessage}</p>
          </div>

          <div class="quiz-stage">
            <div class="capture-form" data-capture-form>
              <h3 class="capture-q">Let Lastcall handle the sale. You get what it's worth.</h3>
              <form action="/api/walkthrough" method="post" enctype="multipart/form-data" data-walkthrough>
                <div class="capture-row">
                  <label for="f-name">Name</label>
                  <input id="f-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" enterkeyhint="next" />
                  <p class="error" id="e-name" hidden></p>
                </div>
                <div class="capture-row">
                  <label for="f-email">Email</label>
                  <input id="f-email" name="email" type="email" required maxlength="200" autocomplete="email" inputmode="email" enterkeyhint="next" />
                  <p class="error" id="e-email" hidden></p>
                </div>
                <div class="capture-row">
                  <label for="f-phone">Phone</label>
                  <input id="f-phone" name="phone" type="tel" maxlength="20" autocomplete="tel" inputmode="tel" enterkeyhint="next" placeholder="Optional" />
                  <p class="error" id="e-phone" hidden></p>
                </div>
                <div class="capture-row">
                  <label for="f-location">Location</label>
                  <input id="f-location" name="location" type="text" maxlength="100" autocomplete="address-level2" enterkeyhint="send" placeholder="Optional" />
                  <p class="error" id="e-location" hidden></p>
                </div>
                <div class="hp" aria-hidden="true">
                  <label for="f-website">Leave this empty</label>
                  <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
                </div>
                <input type="hidden" name="started" value="" />
                <p class="capture-error" id="e-form" role="alert" hidden></p>
                <button type="submit" class="capture-go">{cta}</button>
              </form>
              <p class="capture-fine">We only use your details to contact you about this request. No mailing lists.</p>
            </div>

            <div id="thanks" class="state quiz-result capture-done" tabindex="-1" role="status">
              <div class="quiz-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>
              </div>
              <p class="eyebrow">You're all set</p>
              <h3>We'll take it from here.</h3>
              <p>We will be in touch{P.replyOneBusinessDay ? ' within one business day' : ' soon'} to set up your free walkthrough. Need us sooner? Call <a href={telHref}>{site.phoneDisplay}</a>.</p>
              <p id="demo-note" class="capture-demo" hidden>Demo mode: your details were checked, but nothing was sent.</p>
            </div>
          </div>

          <p class="quiz-note">Free walkthrough. No obligation. Or call <a href={telHref}>{site.phoneDisplay}</a>.</p>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="bingo" aria-labelledby="faq-title" data-bingo>
        <p class="bingo-status" data-bingo-status aria-live="polite">Flip a square to see the answer.</p>
        <div class="bingo-sheet">
          <h2 id="faq-title" class="bingo-letters" aria-label="FAQ">
            {['F', 'A', 'Q'].map((letter) => <span aria-hidden="true">{letter}</span>)}
          </h2>
          <ul class="bingo-grid">
            {bingoSquares.map((square, i) => square ? (
              <li class="bingo-square">
                <button type="button" class="bingo-flip" aria-expanded="false" aria-controls={`faq-a-${i}`} aria-labelledby={`faq-q-${i}`}></button>
                <div class="bingo-inner">
                  <div class="bingo-face bingo-front">
                    <span class="bingo-number" aria-hidden="true">{square.number}</span>
                    <h3 id={`faq-q-${i}`}>{square.q}</h3>
                    <span class="bingo-hint" aria-hidden="true">Flip</span>
                  </div>
                  <div class="bingo-face bingo-back" id={`faq-a-${i}`}>
                    <p>{square.a}</p>
                    <span class="bingo-hint" aria-hidden="true">Flip back</span>
                  </div>
                </div>
              </li>
            ) : (
              <li class="bingo-free">
                <a href="#walkthrough">
                  <strong>Free</strong>
                  <span>walkthrough</span>
                  <em>{cta}</em>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
      <script>
        import { mountBingo } from '../scripts/bingo';
        const bingo = document.querySelector('[data-bingo]');
        if (bingo instanceof HTMLElement) mountBingo(bingo);
      </script>
