---
// Online sale, drawn in ink: we photograph the lamp, list it, the offers come in, SOLD.
---
<svg class="sketch sk-online" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <g class="sk-ink">
    <path class="d" pathLength="1" d="M18 502 C200 496 400 506 582 498" />

    <!-- the lamp on a stool -->
    <path class="d" pathLength="1" d="M66 432 H194 M82 432 L74 500 M178 432 L186 500 M78 468 H182" />
    <ellipse class="paper" cx="130" cy="428" rx="32" ry="6" />
    <path class="d" pathLength="1" d="M130 422 V342" />
    <path class="paper d" pathLength="1" d="M84 342 H176 L160 272 H100 Z" />
    <path class="pop pop-y" d="M84 342 H176 L160 272 H100 Z" />
    <path class="thin" d="M112 284 L106 332 M130 284 V332 M148 284 L154 332" />
    <g class="on-lamp-tag">
      <path class="thin" d="M172 340 L190 362" />
      <rect class="paper" x="178" y="360" width="48" height="27" rx="4" />
      <text class="sk-t sk-tag" x="202" y="378">$40</text>
    </g>

    <!-- the phone -->
    <g class="on-phone">
      <rect class="paper" x="250" y="100" width="190" height="400" rx="28" />
      <rect class="thin" x="264" y="128" width="162" height="344" rx="14" />
      <path class="thin" d="M326 114 h38" />

      <!-- screen A: the camera -->
      <g class="on-cam">
        <path class="thin on-grid" d="M318 128 V472 M372 128 V472 M264 243 H426 M264 357 H426" />
        <path class="thin" d="M300 246 v-14 h14 M376 232 h14 v14 M390 356 v14 h-14 M314 370 h-14 v-14" />
        <path class="paper" d="M318 300 H372 L362 258 H328 Z" />
        <path class="pop pop-y" d="M318 300 H372 L362 258 H328 Z" />
        <path class="thin" d="M345 300 V350 M327 352 H363" />
        <circle class="paper" cx="345" cy="436" r="19" />
        <circle class="thin" cx="345" cy="436" r="12" />
      </g>
      <rect class="on-flash" x="264" y="128" width="162" height="344" rx="14" />

      <!-- screen B: the listing -->
      <g class="on-list">
        <rect class="paper" x="276" y="142" width="138" height="118" rx="8" />
        <path class="paper" d="M322 222 H368 L360 186 H330 Z" />
        <path class="pop pop-y" d="M322 222 H368 L360 186 H330 Z" />
        <path class="thin" d="M345 222 V246 M332 248 H358" />
        <text class="sk-t on-name" x="280" y="290">Brass lamp</text>
        <text class="sk-t on-price" x="280" y="326">$40</text>
        <path class="thin" d="M281 346 h118 M281 362 h92 M281 378 h104" />
        <rect class="paper" x="276" y="408" width="138" height="40" rx="20" />
        <rect class="pop pop-o" x="276" y="408" width="138" height="40" rx="20" />
        <text class="sk-t sk-tag on-btn" x="336" y="433">LISTED</text>
        <path class="thin" d="M370 428 l5 5 l10 -11" />
      </g>
    </g>

    <!-- offers come in -->
    <g class="on-note on-n1">
      <rect class="paper" x="404" y="150" width="164" height="46" rx="23" />
      <path class="pop pop-b" d="M428 168 c0 -7 10 -9 12 -2 c2 -7 12 -5 12 2 c0 8 -12 14 -12 14 c0 0 -12 -6 -12 -14 Z" />
      <path class="thin" d="M428 168 c0 -7 10 -9 12 -2 c2 -7 12 -5 12 2 c0 8 -12 14 -12 14 c0 0 -12 -6 -12 -14 Z" />
      <text class="sk-t on-note-t" x="510" y="179">12 saves</text>
    </g>
    <g class="on-note on-n2">
      <rect class="paper" x="414" y="214" width="164" height="46" rx="23" />
      <circle class="pop pop-y" cx="440" cy="237" r="11" />
      <circle class="thin" cx="440" cy="237" r="11" />
      <text class="sk-t sk-tag" x="440" y="242">$</text>
      <text class="sk-t on-note-t" x="514" y="243">New offer</text>
    </g>
    <g class="on-note on-n3">
      <rect class="paper" x="404" y="278" width="170" height="52" rx="26" />
      <rect class="pop pop-o" x="404" y="278" width="170" height="52" rx="26" />
      <text class="sk-t on-sold" x="489" y="312">SOLD · $40</text>
    </g>
    <g class="on-spark">
      <path class="pop pop-y" d="M560 262 l5 -13 l5 13 l13 5 l-13 5 l-5 13 l-5 -13 l-13 -5 Z" />
      <path class="thin" d="M560 262 l5 -13 l5 13 l13 5 l-13 5 l-5 13 l-5 -13 l-13 -5 Z" />
    </g>
    <g class="on-spark2">
      <path class="pop pop-y" d="M452 102 l4 -10 l4 10 l10 4 l-10 4 l-4 10 l-4 -10 l-10 -4 Z" />
      <path class="thin" d="M452 102 l4 -10 l4 10 l10 4 l-10 4 l-4 10 l-4 -10 l-10 -4 Z" />
    </g>
  </g>
</svg>
