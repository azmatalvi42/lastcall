---
// Garage sale, drawn in ink: the door rolls up, the table is out, balloons on the sign, sales ring up.
---
<svg class="sketch sk-garage" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <g class="sk-ink">
    <!-- sun -->
    <g class="gs-sun">
      <path class="thin" d="M250 50 v-16 M250 150 v16 M200 100 h-16 M300 100 h16 M215 65 l-11 -11 M285 135 l11 11 M285 65 l11 -11 M215 135 l-11 11" />
    </g>
    <circle class="paper" cx="250" cy="100" r="30" />
    <circle class="pop pop-y" cx="250" cy="100" r="30" />

    <!-- house with the garage -->
    <path class="paper d" pathLength="1" d="M310 472 V262 H566 V472" />
    <path class="d" pathLength="1" d="M292 274 L438 168 L584 274" />
    <rect class="hatch-fill" x="340" y="322" width="196" height="150" />
    <path class="thin" d="M344 372 H532 M344 420 H532" />
    <rect class="paper" x="356" y="342" width="34" height="28" />
    <rect class="paper" x="398" y="350" width="26" height="20" />
    <rect class="paper" x="480" y="392" width="40" height="26" />
    <path class="d" pathLength="1" d="M338 472 V320 H538 V472" />
    <g class="gs-door">
      <rect class="paper" x="340" y="322" width="196" height="150" />
      <rect class="pop pop-o" x="340" y="322" width="196" height="150" />
      <path class="thin" d="M340 352 H536 M340 382 H536 M340 412 H536 M340 442 H536" />
      <path class="thin" d="M426 460 h24" />
    </g>
    <circle class="paper d" pathLength="1" cx="438" cy="226" r="18" />
    <path class="thin" d="M420 226 H456 M438 208 V244" />

    <!-- driveway -->
    <path class="d" pathLength="1" d="M18 474 C200 468 400 478 582 470" />
    <path class="thin d" pathLength="1" d="M338 474 L300 596 M538 474 L586 596" />

    <!-- the sale table -->
    <path class="paper d" pathLength="1" d="M108 404 H352 V416 H108 Z" />
    <path class="d" pathLength="1" d="M128 416 L170 476 M170 416 L128 476 M290 416 L332 476 M332 416 L290 476" />
    <!-- lamp -->
    <path class="thin" d="M140 404 V352 M126 404 H154" />
    <path class="paper" d="M114 352 H166 L156 312 H124 Z" />
    <path class="pop pop-y" d="M114 352 H166 L156 312 H124 Z" />
    <!-- books -->
    <rect class="paper" x="180" y="388" width="62" height="16" rx="2" />
    <rect class="pop pop-b" x="180" y="388" width="62" height="16" rx="2" />
    <rect class="paper" x="186" y="372" width="52" height="16" rx="2" />
    <rect class="pop pop-o" x="186" y="372" width="52" height="16" rx="2" />
    <rect class="paper" x="182" y="356" width="58" height="16" rx="2" />
    <!-- records in a crate -->
    <path class="thin" d="M264 352 L266 372 M276 348 L278 372 M288 350 L289 372 M300 348 L300 372 M312 352 L311 372" />
    <circle class="pop pop-b" cx="300" cy="352" r="14" />
    <rect class="paper" x="256" y="370" width="74" height="34" rx="3" />
    <path class="thin" d="M256 386 H330" />
    <!-- price stickers -->
    <g class="gs-tag gs-t1"><circle class="paper" cx="160" cy="388" r="13" /><text class="sk-t gs-tag-t" x="160" y="392">$5</text></g>
    <g class="gs-tag gs-t2"><circle class="paper" cx="232" cy="346" r="13" /><text class="sk-t gs-tag-t" x="232" y="350">$2</text></g>
    <g class="gs-tag gs-t3"><circle class="paper" cx="330" cy="362" r="13" /><text class="sk-t gs-tag-t" x="330" y="366">$1</text></g>

    <!-- sign with balloons -->
    <g class="gs-sign">
      <path class="d" pathLength="1" d="M80 474 V268" />
      <rect class="paper" x="22" y="200" width="118" height="68" rx="6" />
      <text class="sk-t gs-sign-t" x="81" y="228">GARAGE</text>
      <text class="sk-t gs-sign-t" x="68" y="252">SALE</text>
      <path class="thin" d="M100 246 h24 m-8 -7 l8 7 l-8 7" />
    </g>
    <g class="gs-balloons">
      <path class="thin" d="M40 200 C34 158 44 128 36 88 M60 200 C64 152 56 118 70 60 M120 200 C126 158 112 134 118 98" />
      <g class="gs-b1"><ellipse class="paper" cx="36" cy="64" rx="22" ry="27" /><ellipse class="pop pop-o" cx="36" cy="64" rx="22" ry="27" /></g>
      <g class="gs-b2"><ellipse class="paper" cx="70" cy="34" rx="22" ry="27" /><ellipse class="pop pop-b" cx="70" cy="34" rx="22" ry="27" /></g>
      <g class="gs-b3"><ellipse class="paper" cx="118" cy="72" rx="22" ry="27" /><ellipse class="pop pop-y" cx="118" cy="72" rx="22" ry="27" /></g>
    </g>
    <!-- "+$" as things sell -->
    <text class="sk-t gs-plus gs-p1" x="140" y="296">+$5</text>
    <text class="sk-t gs-plus gs-p2" x="212" y="338">+$2</text>
    <text class="sk-t gs-plus gs-p3" x="292" y="330">+$1</text>
  </g>
</svg>
